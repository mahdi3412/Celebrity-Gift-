NODE_ENV=development
DATABASE_URL=postgresql://celebritygift:celebritygift@localhost:5432/celebritygift
REDIS_URL=redis://localhost:6379
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
KYC_PROVIDER=manual
KYC_ENCRYPTION_KEY=replace-with-64-hex-chars
KYC_PRIVATE_STORAGE_PATH=.private/kyc
HYPERVERGE_APP_ID=
HYPERVERGE_APP_KEY=
HYPERVERGE_LIVENESS_URL=
HYPERVERGE_FACE_MATCH_URL=https://ind.idv.hyperverge.co/v1/matchFace
HYPERVERGE_AADHAAR_OCR_URL=https://ind-docs.hyperverge.co/v2.0/readAadhaar
HYPERVERGE_PAN_OCR_URL=https://ind-docs.hyperverge.co/v2.0/readPAN
HYPERVERGE_PASSPORT_OCR_URL=https://ind-docs.hyperverge.co/v2.0/readPassport
HYPERVERGE_VOTER_OCR_URL=https://ind-docs.hyperverge.co/v2.0/readVoterID
HYPERVERGE_DL_OCR_URL=https://ind-docs.hyperverge.co/v2.0/readDL
COURIER_PROVIDER=manual
COURIER_FAN_TO_STATION_INR=120
COURIER_STATION_TO_CREATOR_INR=180
DB_AUTO_MIGRATE=true
KYC_WEBHOOK_SECRET=replace-with-32-plus-char-secret
KYC_RETENTION_DAYS=30
SWAGGER_ENABLED=true
WEB_ORIGIN=http://localhost:3000
