  "version":"0.1.0",
  "workspaces":["apps/web","apps/api","apps/cms"],
  "scripts":{"dev":"concurrently \"npm:dev:web\" \"npm:dev:api\"","dev:web":"npm --workspace apps/web run dev","dev:api":"npm --workspace apps/api run start:dev","build":"npm run build:web && npm run build:api && npm run build:cms","build:web":"npm --workspace apps/web run build","build:api":"npm --workspace apps/api run build","build:cms":"npm --workspace apps/cms run build","lint":"npm --workspace apps/web run lint && npm --workspace apps/api run lint","test":"npm run test:api","test:api":"npm --workspace apps/api run test:api"},
